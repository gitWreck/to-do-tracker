# Supabase Configuration
# Found in: Supabase Dashboard -> Settings -> API Keys (or Connect modal)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
# Either VITE_SUPABASE_ANON_KEY or VITE_SUPABASE_PUBLISHABLE_KEY is supported:
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Single-User Strict Email Access Lock
# Set to your own Google email address. Only this email can sign in and access the tracker.
VITE_ALLOWED_EMAIL=your.email@gmail.com

